{
  "name": "kubicle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "kubicle": "bin/kubicle"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "test:mod": "claude plugin test mods/kubicle",
    "test:e2e": "node --disable-warning=ExperimentalWarning --test 'test/e2e/*.e2e.ts'",
    "typecheck": "tsc --noEmit",
    "build:ui": "esbuild src/ui/main.ts --bundle --format=esm --outfile=dist/ui/main.js",
    "start": "npm run build:ui && node --disable-warning=ExperimentalWarning src/server/main.ts",
    "smoke": "bash scripts/smoke-real.sh",
    "install-hooks": "bin/kubicle install-hooks",
    "uninstall-hooks": "bin/kubicle uninstall-hooks"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2"
  }
}
