#!/bin/bash
# Kubicle hook shim. Fail-open: always exits 0.
#   kubicle-hook <max-seconds> [perm|pre|prompt]
# Talks to the office over its private Unix socket (<home>/run/hook.sock, dir mode 0700); no TCP.
# Prints NOTHING unless the kind is `perm` (PermissionRequest) and the trimmed 2xx body is exactly
# one of the two office decisions below, or the kind is `pre` (PreToolUse) and it is exactly the
# guard's "ask", or the kind is `prompt` (UserPromptSubmit) and it is exactly one Bubbles briefing
# (one line, BRIEF_HEAD + a JSON string body + '"}}'). Anything else (an impostor, a stale server)
# can neither inject arbitrary output nor approve tool calls.
set -u
max="${1:-1}"
kind="${2:-}"
case "$max" in ''|*[!0-9]*) max=1 ;; esac

# Must equal hookResponse('allow') / hookResponse('deny') in src/server/approvals.ts (unit-tested).
ALLOW='{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}'
DENY='{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"Denied from Kubicle"}}}'
# Must equal GUARD_ASK / guardResponse() in src/server/permission-flow.ts (unit-tested).
GUARD_ASK='{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"Kubicle: pushes and merges to protected branches need the owner"}}'
# Must equal the start of intakeResponse(BRIEFING_PREFIX + ...) in src/server/bubbles/intake.ts (unit-tested).
BRIEF_HEAD='{"hookSpecificOutput":{"hookEventName":"UserPromptSubmit","additionalContext":"[Kubicle/Bubbles briefing]'
BRIEF_TAIL='"}}'

[ -n "${KUBICLE_AGENT:-}" ] && exit 0

home="${KUBICLE_HOME:-$HOME/.kubicle}"
token=""
if [ -r "$home/ingest-token" ]; then
  token=$(tr -d '[:space:]' < "$home/ingest-token" 2>/dev/null)
fi
[ -n "$token" ] || exit 0
sock="$home/run/hook.sock"
[ -S "$sock" ] || exit 0 # no office running: nothing to do, and no curl wait

# Only a shim that can deliver a decision asks the office to wait for one (`pre` is the guard's answer).
hkind="event"
[ "$kind" = "perm" ] && hkind="perm"
[ "$kind" = "pre" ] && hkind="pre"
[ "$kind" = "prompt" ] && hkind="prompt"

# Optional placement hints; sent only when they look like a building id (never raw env text).
extra=()
if [[ "${KUBICLE_DIVISION:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  extra+=(-H "X-Kubicle-Division: $KUBICLE_DIVISION")
fi
if [[ "${KUBICLE_ROOM:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; then
  extra+=(-H "X-Kubicle-Room: $KUBICLE_ROOM")
fi
# The office's launch id (kubicle agent sets it): lets the office see that a window it opened checked in.
if [[ "${KUBICLE_LAUNCH:-}" =~ ^[0-9a-f-]{36}$ ]] && [ "${#KUBICLE_LAUNCH}" -eq 36 ]; then
  extra+=(-H "X-Kubicle-Launch: $KUBICLE_LAUNCH")
fi

# While the office waits it sends a space every 0.5 s; a frozen server sends nothing, so
# --speed-limit/--speed-time give up after ~3 s instead of holding the session for the full max.
out=$(curl -s --unix-socket "$sock" -m "$max" --connect-timeout 1 --speed-limit 1 --speed-time 3 -X POST \
  -H 'Content-Type: application/json' \
  -H "X-Kubicle-Token: $token" \
  -H "X-Kubicle-Hook-Kind: $hkind" \
  ${extra[@]+"${extra[@]}"} \
  --data-binary @- \
  -w $'\n%{http_code}' \
  "http://kubicle/hooks" 2>/dev/null)
rc=$?
[ "$rc" -eq 0 ] || exit 0
[ "$hkind" != "event" ] || exit 0

code="${out##*$'\n'}"
body="${out%$'\n'*}"
case "$code" in 2??) ;; *) exit 0 ;; esac

# Trim leading/trailing whitespace (heartbeat spaces), bash 3.2-safe.
body="${body#"${body%%[![:space:]]*}"}"
body="${body%"${body##*[![:space:]]}"}"
# True only for exactly one briefing: one line, the fixed head, then the rest of ONE JSON string (no raw
# quote once escapes are removed, so nothing can add keys after additionalContext), then the fixed tail.
is_briefing() {
  local b="$1" mid
  case "$b" in *$'\n'*|*$'\r'*) return 1 ;; esac
  [ "${#b}" -ge $(( ${#BRIEF_HEAD} + ${#BRIEF_TAIL} )) ] || return 1
  [ "${b:0:${#BRIEF_HEAD}}" = "$BRIEF_HEAD" ] || return 1
  [ "${b:$(( ${#b} - ${#BRIEF_TAIL} ))}" = "$BRIEF_TAIL" ] || return 1
  mid="${b:${#BRIEF_HEAD}:$(( ${#b} - ${#BRIEF_HEAD} - ${#BRIEF_TAIL} ))}"
  mid="${mid//\\\\/}"  # escaped backslashes first (left to right, as JSON reads them)
  mid="${mid//\\\"/}"  # then escaped quotes
  case "$mid" in *'"'*|*'\') return 1 ;; esac
  return 0
}

if [ "$hkind" = "perm" ]; then
  if [ "$body" = "$ALLOW" ] || [ "$body" = "$DENY" ]; then printf '%s' "$body"; fi
elif [ "$hkind" = "prompt" ]; then
  if is_briefing "$body"; then printf '%s' "$body"; fi
elif [ "$body" = "$GUARD_ASK" ]; then
  printf '%s' "$body"
fi
exit 0
